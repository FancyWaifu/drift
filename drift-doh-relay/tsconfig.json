{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "Bundler",
        "lib": ["ES2022"],
        "strict": true,
        "noImplicitAny": true,
        "skipLibCheck": true,
        "types": ["@cloudflare/workers-types"]
    },
    "include": ["src/**/*.ts"]
}
