# Caddy reverse proxy on the "client machine" — fronts the
# local drift node's http:// listener. Identical pattern to
# http-proxy-demo/Caddyfile; what differs in this demo is the
# topology around it (the local node also federates outbound
# to a remote bridge).

{
	admin off
	auto_https off
}

:8080 {
	reverse_proxy /drift-sse client-node:51820 {
		flush_interval -1
		transport http {
			read_timeout 24h
			response_header_timeout 30s
			keepalive 5m
		}
	}
	reverse_proxy /drift-send client-node:51820
	reverse_proxy /drift-send* client-node:51820
}
