# Minimal caddy reverse proxy for the drift http:// demo.

{
	admin off
	auto_https off
}

:8080 {
	# Long timeout for SSE — the GET /drift-sse stays open for
	# the lifetime of the session.
	reverse_proxy /drift-sse drift-bridge:51820 {
		flush_interval -1
		transport http {
			read_timeout 24h
			response_header_timeout 30s
			keepalive 5m
		}
	}

	# Short-lived POST — default transport is fine.
	reverse_proxy /drift-send drift-bridge:51820

	# OPTIONS for CORS preflight — proxy through unchanged.
	reverse_proxy /drift-send* drift-bridge:51820
}
